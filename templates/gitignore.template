# cheat-on-content — content project .gitignore
# Generated by /cheat-init. Purpose: keep credentials and local machine state
# out of git while keeping the calibration archive in version control.
#
# Do NOT ignore predictions/, scripts/, videos/, articles/, xhs/, or samples/.
# Those directories are part of the prediction archive and feedback loop.
#
# Note: gitignore comments must be on their own line — an inline `#` is NOT a
# comment (it becomes part of the pattern), so never append notes after a path.

# Credentials / login state: never commit these.
.auth/
.auth-xhs/
.auth-linkedin/
# .auth-wechat-channels/ = 视频号助手 Playwright 登录态
.auth-wechat-channels/
.cheat-secrets.json

# Local cache and generated hook copies.
.cheat-cache/
.cheat-hooks/
.debug/

# Claude Code local settings may contain machine-specific paths and permissions.
.claude/

# Python runtime leftovers from adapters and tools.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version

# macOS / editors / temporary files.
.DS_Store
._*
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp
*.log
